FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "../generatedInput"

convertToMeters $DELTA_X;
x_min 0;
x_max $MESH_X; //direction of growth
y_min 0;
y_max $MESH_Y;
z_min 0;
z_max $MESH_Z;



// should all be integers
lx #calc "$x_max - $y_min";
ly #calc "$y_max - $y_min";
lz #calc "$z_max - $z_min"; // should all be integers
vertices
(
	($x_min $y_min $z_min)
    ($x_max $y_min $z_min)
    ($x_max $y_max $z_min)
    ($x_min $y_max $z_min)
    ($x_min $y_min $z_max)
    ($x_max $y_min $z_max)
    ($x_max $y_max $z_max)
    ($x_min $y_max $z_max)
);

blocks
(
 hex (0 1 2 3 4 5 6 7) ($lx $ly 1) simpleGrading (1 1 1) // for dx = 0.5: simpleGrading (2 2 2) or convertToMeters = 0.5
   // hex (0 1 5 4 3 2 6 7) ($lx $ly 1) simpleGrading (1 1 1) // for dx = 0.5: simpleGrading (2 2 2) or convertToMeters = 0.5
);

//================ FOR ZERO-FLUX BOUNDARY CONDITIONS ============
boundary
(
    floor
    {
        type zeroGradient;
        faces
        (
            (0 1 5 4)
        );
    }
    
    ceiling
    {
        type zeroGradient;
        faces
        (
            (2 3 7 6)
        );
    }    
    electrode
    {
        type fixedValue;
        faces
        (
            (0 4 7 3)
        );
    }
    electrolyte
    {
        type fixedValue;
        faces
        (
            (1 2 6 5)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
    
);

mergePatchPairs
(
        
);


