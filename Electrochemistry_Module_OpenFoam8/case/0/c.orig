FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      c;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    floor
    {
        type            zeroGradient;
    }
    boxtoCell
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    ceiling
    {
        type            zeroGradient;
    }
    electrode
    {
        type            fixedValue;
        value           uniform 0.0;
    }
    electrolyte
    {
        type            fixedValue;
        value           uniform 1.0;
    }
}

