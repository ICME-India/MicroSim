Bootstrap: docker
From: ubuntu:22.04

%labels
    Author MCCH Team
    Version 1.0.0
    Description Generalized Multi-Component Cahn-Hilliard Phase-Field Solver & Studio

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C
    export PIP_BREAK_SYSTEM_PACKAGES=1
    export PATH=/opt/mcch/bin:$PATH
    export LD_LIBRARY_PATH=/opt/mcch/lib:$LD_LIBRARY_PATH
    export PYTHONPATH=/opt/mcch/share/mcch/python:/workspace:$PYTHONPATH

%post
    export PIP_BREAK_SYSTEM_PACKAGES=1
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        libopenmpi-dev \
        openmpi-bin \
        libfftw3-dev \
        libfftw3-mpi-dev \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        git \
        ca-certificates

    # Build and install solver into /opt/mcch
    mkdir -p /build
    cd /build
    # Assuming code is copied or cloned, or build minimal tree
    # If building within container:
    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    if [ $# -eq 0 ]; then
        echo "Usage: apptainer run <image.sif> [mcch_solver args | studio]"
        echo "Examples:"
        echo "  apptainer exec --nv mcch.sif mcch_solver -c config.json"
        echo "  apptainer run mcch.sif studio --port 5000"
        exit 0
    fi

    if [ "$1" = "studio" ]; then
        shift
        exec python3 /opt/mcch/share/mcch/python/../run_app.py "$@"
    else
        exec mcch_solver "$@"
    fi
