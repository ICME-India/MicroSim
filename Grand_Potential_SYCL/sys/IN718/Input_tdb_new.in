##Geometrical dimensions of the simulation domain
DIMENSION = 2;
MESH_X = 100;
MESH_Y = 200;
MESH_Z = 100;
##Discretization, space and time
DELTA_X = 0.85e-8;
DELTA_Y = 0.85e-8;
DELTA_Z = 0.85e-8;
DELTA_t = 4.80e-9; 
##Number of phases and composition
NUMPHASES = 2;
NUMCOMPONENTS = 10;
#Running and saving information
NTIMESTEPS = 500000;
NSMOOTH = 10;
SAVET = 100;
STARTTIME = 0;
RESTART = 0;
numworkers = 4;
## Component and Phase names
# COMPONENTS = {Al,Cu,B};
COMPONENTS = {Si,Co,Ti,Cr,Mn,Fe,Al,Nb,Mo,Ni};
PHASES = {FCC, LIQUID};
