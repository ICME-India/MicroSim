DIFFUSIVITY = {1, 1, 3e-9, 3e-9, 3e-9, 3e-9, 3e-9, 3e-9, 3e-9, 3e-9, 3e-9};
##Gas constant and molar volume
R = 8.314;
V = 10e-6;
ELASTICITY = 0;
##Elasticity related parameters
EIGEN_STRAIN = {0, 0.01, 0.01, 0.0, 0.0, 0.0, 0.0};
