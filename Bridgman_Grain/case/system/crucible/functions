FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/Domain2";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

 volFieldValue1
 {
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");

    log             true;
    writeControl    none;
    executeControl  none;
    writeFields     true;
    writeLocation   true;

    select          all;

    operation       min;

    fields
    (
       BPhi
    );
 }





