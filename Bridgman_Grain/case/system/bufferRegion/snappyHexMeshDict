FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;

snap            false;

addLayers       false;

geometry
{
    motorBike1.stl
    {
        type            triSurfaceMesh;
        file            "motorBike1.stl";
        name            motorBike1;
    }
}

castellatedMeshControls
{
    maxLocalCells   4000000;
    maxGlobalCells  8000000;
    minRefinementCells 0;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels 6;
    features        ( { file "motorBike1.eMesh" ; level 1 ; } );
    refinementSurfaces
    {
        motorBike1
        {
            level           ( 1 1 );
            faceType        baffle;
            faceZone        motorBike1_zone;
            //faceType        baffle;
            //faceZone        motorBike_zone;
            //faceType        baffle;
            //faceZone        motorBike_zone;
            //faceType        baffle;
            //faceZone        motorBike_zone;
            //faceType        baffle;
            //faceZone        motorBike_zone;
            //faceType        baffle;
            //faceZone        motorBike_zone;
        }
    }
    resolveFeatureAngle 10;
    refinementRegions
    {
        motorBike1
        {
            mode            distance;
            levels          ((0.00017 1) );
        }
    }
    locationInMesh  ( 0.001 0.0015 0.001 );
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    1;
    nSmoothInternal 1;
    tolerance       2;
    nSolveIter      100;
    nRelaxIter      1;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes   false; //true;

    layers
    {
        "(motorBike).*"
        {
            nSurfaceLayers  1;
        }
    }

    expansionRatio  1;
    finalLayerThickness 0.03;
    minThickness    0.01;
    nGrow           0;
    featureAngle    60;
    slipFeatureAngle 30;
    nRelaxIter      3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals  3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter      50;
}

meshQualityControls
{
    maxNonOrtho     65;
    maxBoundarySkewness 3;
    maxInternalSkewness 2;
    maxConcave      80;
    minVol          1e-13;
    minTetQuality   -1e+30;
    minArea         -1;
    minTwist        0.02;
    minDeterminant  0.001;
    minFaceWeight   0.02;
    minVolRatio     0.01;
    minTriangleTwist -1;
    nSmoothScale    1;
    errorReduction  0.75;
}

writeFlags      ( scalarLevels layerSets layerFields );

mergeTolerance  1e-06;


