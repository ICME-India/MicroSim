convertToMeters  2e-6;

x_min 0;
x_max 207;
y_min 0;
y_max 600;
z_min   0;
z_max   1;

vertices
(
    ($x_min $y_min $z_min)
    ($x_max $y_min $z_min)
    ($x_max $y_max $z_min)
    ($x_min $y_max $z_min)
    ($x_min $y_min $z_max)
    ($x_max $y_min $z_max)
    ($x_max $y_max $z_max)
    ($x_min $y_max $z_max)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (207 600 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    top
    {
        type symmetry;
        neighbourPatch bottom;
        faces
        (
            (0 1 5 4)
        );
    }

    bottom
    {
        type symmetry;
        neighbourPatch top;
        faces
        (
            (2 3 7 6)
        );
    }

    left
    {
        type symmetry;
        faces
        (
            (1 2 6 5)
        );	
    }

    right
    {
        type symmetry;
        faces
        (
            (0 4 7 3)
        );	
    }
    
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
    
    internal
    {
        type internal;
        faces ();
    }
);

